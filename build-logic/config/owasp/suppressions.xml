        <gav regex="true">^org\.springdoc:springdoc-openapi-starter-webmvc-ui:.*$</gav>
        <cve>CVE-2025-26791</cve>
    </suppress>

    <!-- CVE-2025-48924: commons-lang3 StackOverflowError on extremely long inputs.
         CVSS score is MEDIUM (below the 7.0 threshold); suppressed here for
         explicitness while an upgrade path via Spring Boot BOM is awaited.
         Remove once Spring Boot ships commons-lang3 >= 3.18.0 in its BOM. -->
    <suppress>
        <notes>CVE-2025-48924 is MEDIUM severity (CVSS &lt; 7.0). commons-lang3 is a transitive dep managed by Spring Boot BOM; not directly exploitable in this service.</notes>
        <gav regex="true">^org\.apache\.commons:commons-lang3:.*$</gav>
        <cve>CVE-2025-48924</cve>
    </suppress>

