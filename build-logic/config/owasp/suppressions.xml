        <notes>False positive: CVE-2025-7962 does not affect angus-activation; incorrect CPE mapping for eclipse:angus_mail.</notes>
        <gav regex="true">^org\.eclipse\.angus:angus-activation:.*$</gav>
        <cve>CVE-2025-7962</cve>
    </suppress>

