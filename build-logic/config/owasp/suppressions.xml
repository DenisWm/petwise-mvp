        <notes>DOMPurify CVEs inside swagger-ui-bundle.js are false positives for a server-side app; bundled static JS asset.</notes>
        <gav regex="true">^org\.springdoc:springdoc-openapi-starter-webmvc-ui:.*$</gav>
        <cve>CVE-2024-45801</cve>
