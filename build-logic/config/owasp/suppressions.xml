        <notes>False positive: CVE-2025-15104 does not affect hibernate-validator; incorrect CPE mapping.</notes>
        <gav regex="true">^org\.hibernate\.validator:hibernate-validator:.*$</gav>
        <cve>CVE-2025-15104</cve>
    </suppress>

    <!-- CVE-2025-68161: Reported against log4j-api via CPE matching on
