<?xml version="1.0"?>
<ruleset name="Custom Rules" xmlns="http://pmd.sourceforge.net/ruleset/2.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://pmd.sourceforge.net/ruleset/2.0.0
         https://pmd.sourceforge.io/ruleset_2_0_0.xsd">
    <description>
        Custom rules to use on the project
        The source of rule sets
        https://github.com/pmd/pmd/tree/master/pmd-java/src/main/resources/category/java
    </description>

    <!-- There is right place to disable or configure some rules -->
    <rule ref="category/java/bestpractices.xml"/>
    <rule ref="category/java/codestyle.xml">
        <exclude name="CommentDefaultAccessModifier"/>
        <!-- The var keyword has been in Java since version 10 -->
        <exclude name="UseExplicitTypes"/>
        <!-- Checkstyle requires explicit empty constructors for Javadoc;
             PMD and Checkstyle disagree — Checkstyle wins -->
        <exclude name="UnnecessaryConstructor"/>
        <!-- Related to UnnecessaryConstructor — same rationale -->
        <exclude name="CallSuperInConstructor"/>
        <!-- Fields annotated with @Autowired/@MockitoBean must follow
             Spring conventions; field order is enforced by the framework -->
        <exclude name="FieldDeclarationsShouldBeAtStartOfClass"/>
    </rule>
    <rule ref="category/java/design.xml">
        <!-- The rule requires manual configuration -->
        <exclude name="LoosePackageCoupling"/>
        <!-- Is not applicable for modern coding style -->
        <exclude name="LawOfDemeter"/>
        <!-- Use-case commands intentionally use multiple String params -->
        <exclude name="UseObjectForClearerAPI"/>
    </rule>
    <rule ref="category/java/documentation.xml">
        <!-- Empty constructors are required by Checkstyle/Javadoc policy;
             suppress PMD's complementary documentation rule -->
        <exclude name="UncommentedEmptyConstructor"/>
        <!-- Javadoc blocks for records and complex types exceed the
             default 5-line / 80-char limits; suppress globally -->
        <exclude name="CommentSize"/>
    </rule>
    <rule ref="category/java/errorprone.xml"/>
    <rule ref="category/java/multithreading.xml"/>
    <rule ref="category/java/performance.xml"/>
    <rule ref="category/java/security.xml"/>

    <rule ref="category/java/codestyle.xml/ClassNamingConventions">
        <properties>
            <property name="classPattern" value="[A-Z][a-zA-Z0-9]*" />
            <property name="abstractClassPattern" value="[A-Z][a-zA-Z0-9]*" />
            <property name="interfacePattern" value="[A-Z][a-zA-Z0-9]*" />
            <property name="enumPattern" value="[A-Z][a-zA-Z0-9]*" />
            <property name="annotationPattern" value="[A-Z][a-zA-Z0-9]*" />
            <property name="utilityClassPattern" value="[A-Z][a-zA-Z0-9]*" />
            <!-- Recognize Maven integration test convention: FooIT.java -->
            <property name="testClassPattern" value="^Test.*$|^[A-Z][a-zA-Z0-9]*Test(s|Case)?$|^[A-Z][a-zA-Z0-9]*IT$" />
        </properties>
    </rule>

    <!-- Uncomment this if do want to exclude tests classes from analysis -->
    <!-- <exclude-pattern>.*/src/test/.*</exclude-pattern> -->

    <!-- Allow variable names up to 20 characters to accommodate descriptive
         domain names like appointmentGateway and appointmentIdValue -->
    <rule ref="category/java/codestyle.xml/LongVariable">
        <properties>
            <property name="minimum" value="21" />
        </properties>
    </rule>

</ruleset>