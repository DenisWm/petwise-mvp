# Enforce LF line endings for all text files
* text=auto eol=lf

# Explicitly declare text files
*.java text eol=lf
*.kt text eol=lf
*.kts text eol=lf
*.gradle text eol=lf
*.xml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.properties text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.json text eol=lf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.sh text eol=lf
*.toml text eol=lf
*.puml text eol=lf
*.rb text eol=lf
*.lock text eol=lf
Makefile text eol=lf
Dockerfile text eol=lf
Gemfile text eol=lf

# Windows batch files must keep CRLF
*.bat text eol=crlf

# Binary files - no line ending conversion
*.jar binary
*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.pdf binary
